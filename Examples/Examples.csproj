<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Wasm2IL/Wasm2IL.csproj" />
    </ItemGroup>

    <ItemGroup>
        <WatFile Include="WatFiles/mathlib.wat"/>
    </ItemGroup>

    <Target Name="WatToWasm" BeforeTargets="Build">
        <Exec Command="wat2wasm %(WatFile.Identity) -o $(OutputPath)%(WatFile.Filename).wasm" />
    </Target>

</Project>
